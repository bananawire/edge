# --- Turso (remote libSQL) -------------------------------------------------
# Production: set EDGE_TURSO_URL and EDGE_TURSO_TOKEN. The edge talks to a
# remote libSQL database over HTTPS — no local file is created.
#
# Create the database + token once with the Turso CLI:
#   turso db create <name>
#   turso db tokens create <name>
# EDGE_TURSO_URL must be the libsql:// URL printed by `turso db show <name>`.
EDGE_TURSO_URL=
EDGE_TURSO_TOKEN=

# --- Local libSQL fallback -------------------------------------------------
# Legacy / dev fallback. Used only when EDGE_TURSO_URL is empty (unit tests,
# local dev without internet). Same libsql client serves a local file so the
# schema/DDL code paths stay identical.
EDGE_DATABASE_PATH=clair_edge.db

# Core ↔ edge service authentication (set strong secrets in production)
EDGE_TOKEN=replace-with-core-to-edge-token
EDGE_TO_CORE_TOKEN=replace-with-edge-to-core-token
CLAIR_CORE_BASE_URL=http://localhost:49220
# Plain HTTP is accepted for loopback only; set this on a trusted LAN/container network.
CLAIR_CORE_ALLOW_INSECURE_HTTP=false
CLAIR_CORE_HTTP_TIMEOUT=10

# Telemetry contract v1: reject readings without measured_at once all firmware sends it
EDGE_REQUIRE_MEASURED_AT=false
# Quarantined outbox rows are purged after this many hours
EDGE_OUTBOX_DEAD_LETTER_RETENTION_HOURS=168

# Background worker intervals (seconds; values below 0.1 are clamped)
DEVICE_ROSTER_POLL_INTERVAL_SECONDS=30
EDGE_COMMAND_POLL_INTERVAL_SECONDS=5
EDGE_ALERT_POLL_INTERVAL_SECONDS=5
EDGE_PRESENCE_POLL_INTERVAL_SECONDS=5
EDGE_OUTBOX_POLL_INTERVAL_SECONDS=5

# Docs (optional)
EDGE_PUBLIC_BASE_URL=http://127.0.0.1:5000

# CORS (use comma-separated origins in production, e.g. https://admin.example.com)
EDGE_CORS_ALLOWED_ORIGINS=*
EDGE_CORS_ALLOWED_HEADERS=Content-Type,X-Hardware-Id,X-API-Key